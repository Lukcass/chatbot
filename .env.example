# Copia a .env. SIN valores reales aquí. Si falta algo de la IA, Papanauta funciona en modo básico (reglas).
PORT=8787
ALLOWED_ORIGIN=              # origen de la web principal, p. ej. https://tuweb.com (vacío = mismo origen)
RATE_LIMIT_PER_MIN=60        # anti-abuso: peticiones por minuto por IP a /chat (0 = sin límite). Si muchos usuarios comparten IP (colegio, evento) súbelo
TRUST_PROXY=                 # 1 si estás detrás de un proxy/hosting que envía x-forwarded-for

# --- IA generativa (con soporte de herramientas / function calling) ---
LLM_PRESET=groq           # gemini | groq | mistral | cerebras | openrouter | anthropic
LLM_PROVIDER=                # solo si NO usas preset: anthropic | openai (openai = API compatible)
LLM_API_KEY=example
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=                # solo para openai-compatible fuera de los presets (p. ej. Ollama: http://localhost:11434/v1)
LLM_MAX_TOKENS=1200
LLM_RPM=10                   # peticiones por minuto que permite TU plan de ese proveedor (confírmalo en su consola)

# --- Proveedores de respaldo (OPCIONALES, hasta _4). Si el principal se queda sin cupo, se usa el siguiente ---
# Usa PROVEEDORES DISTINTOS (una clave por proveedor); varias cuentas del mismo proveedor pueden violar sus términos.
LLM_PRESET_2=groq
LLM_API_KEY_2=
LLM_MODEL_2=
LLM_RPM_2=10
# LLM_PRESET_3=mistral  LLM_API_KEY_3=  LLM_MODEL_3=  LLM_RPM_3=2

# --- Muchos usuarios a la vez: reparto del cupo de IA ---
LLM_CONCURRENCY=4            # llamadas a la IA simultáneas; el resto espera en cola
LLM_QUEUE_WAIT_MS=6000       # espera máxima en cola antes de pasar al modo básico
LLM_PER_USER_HOUR=15         # respuestas con IA por usuario por hora; al pasarse sigue en modo básico (0 = sin límite)
CACHE_TTL_MIN=60             # minutos que se reutiliza una respuesta de IA a la misma pregunta (0 = sin caché)
LLM_ON_CHIPS=                # 1 = usar IA también en las preguntas sugeridas (por defecto las responde el motor de reglas)

# --- Datos procesados (elige UNA vía) ---
DATA_DIR=                    # carpeta con los JSON de sitios (vacío = data/sites/ del módulo)
GROUNDY_API_URL=             # API de Groundy (PENDIENTE de contrato). Si se define, reemplaza a los archivos
GROUNDY_API_KEY=
