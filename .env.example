# Copia a .env y exporta las variables (o usa tu gestor de secretos). SIN valores reales aquí.
PORT=8787
ALLOWED_ORIGIN=              # origen de la web principal, p. ej. https://tuweb.com (vacío = mismo origen)

# --- IA generativa (PENDIENTE). Si falta alguna, Papanauta usa el modo básico por reglas ---
LLM_PRESET=groq                # gemini | groq | mistral | cerebras | openrouter | anthropic  (atajo: rellena proveedor y URL)
LLM_PROVIDER=                # solo si NO usas preset: anthropic | openai (openai = API compatible)
LLM_API_KEY=your_groq_api_key_here
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=                # solo para openai-compatible, p. ej. https://api.openai.com/v1

# --- NASA (PENDIENTE: usa solo el adaptador Groundy/NASA del equipo) ---
NASA_DATA_PROVIDER=          # nombre de la fuente aprobada
NASA_API_URL=
NASA_API_KEY=
NASA_COORDINATES=            # opcional: lat,lon por defecto
NASA_START_DATE=
NASA_END_DATE=

# --- Visión artificial (PENDIENTE) ---
VISION_API_URL=
VISION_API_KEY=
